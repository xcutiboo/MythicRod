# Authoritative base language for MythicRod (Crowdin-ready)
# Keys are stable, descriptive, and namespaced.

general:
  no_permission: "<red>You don't have permission to do that."
  error: '<red>Something went wrong. Check the server logs for details.'
  player_only: '<red>This command can only be used by players!'
  prefix: '<gold><bold>[MythicRod] <reset>'

command:
  help:
    header: '<gold><bold>━━━ <white>MythicRod Commands <gold><bold>━━━'
    gui: '<yellow>/mythicrod gui <gray>- Open main GUI'
    reload: '<yellow>/mythicrod reload <gray>- Reload configuration (admin only)'
    stats: '<yellow>/mythicrod stats [player] <gray>- View fishing statistics'
    top: '<yellow>/mythicrod top [limit] <gray>- View leaderboard'
    drops: '<yellow>/mythicrod drops [category] <gray>- View available drops'
    help: '<yellow>/mythicrod help <gray>- Show this help message'
  reload:
    start: '<yellow>Reloading configuration...'
    success: '<green>Configuration reloaded successfully!'
    failed: '<red>Failed to reload: <yellow>{error}'
  player_not_found: '<red>No player named <yellow>{player}<red> found.'

stats:
  permission_denied: "<red>You don't have permission to view stats."
  header: '<gold><bold>━━━ <white>Fishing Stats: <yellow>{player} <gold><bold>━━━'
  total_catches: '<gray>Total Catches: <white>{total}'
  items_caught: '<gray>Items Caught: <white>{items}'
  unique_types: '<gray>Unique Types: <white>{unique}'
  rare_catches: '<gray>Rare Catches: <yellow>{rare}'
  console_usage: '<red>Please specify a player name when using this from console.'
  limit_invalid: '<red>Limit must be between <yellow>1<red> and <yellow>100<red>.'

leaderboard:
  header_top: '<aqua><bold>═══════════════════════════'
  title: '<gold><bold>Top Fishers Leaderboard'
  entry_suffix: '<gray> - {count} catches'
  footer_bottom: '<aqua><bold>═══════════════════════════'

drops:
  header: '<gold><bold>━━━ <white>Available Drops <gold><bold>━━━'
  category_header: '<gold><bold>━━━ <white>Drops: <yellow>{category} <gold><bold>━━━'
  category_entry: '<yellow>{category}<gray>: <white>{count} items'
  category_not_found: '<red>No drops found in category <yellow>{category}<red>.'
  available_categories: '<gray>Available categories: <white>{categories}'
  usage: '<gray>Use <yellow>/mythicrod drops {category}<gray> to see items.'

fishing:
  catch-normal: '<green>✓ <green>Caught <yellow>{amount}× {item}<green>!'
  catch-rare: '<aqua><bold>✦ RARE CATCH! <white>You reeled in <yellow>{amount}× {item}<white>!'
  catch-legendary: '<light_purple><bold>✦ LEGENDARY! <white>You discovered <yellow>{amount}× {item}<white>!'
  stats-recorded: '<gray>+1 Fishing Stat Recorded'

# GUI Language Menu
gui:
  language:
    title: '<gold><bold>MythicRod <dark_gray>🌐 <gray>Language Selection'
    info:
      name: '<gold><bold>Language Settings'
      select: '<gray>Choose your preferred language'
    languages:
      english:
        name: 'English'
        description: 'Switch to English'
        region: 'United Kingdom'
      japanese:
        name: '日本語'
        description: '日本語に切り替える'
        region: 'Japan · 日本'
    back:
      name: '<yellow>← Back to Configuration'
      lore: '<gray>Return to the configuration menu'
    indicator:
      prefix: '✓ '
      suffix: ' ✓'
    status:
      active: '✓ Currently Active'
      inactive: 'Click to activate'
    separator: '━━━━━━━━━━━━━━━'
    changed: '<green>✓ Language changed to <white>{name}<green>!'
    changed-info: '<gray>All menus and messages will now display in {name}.'
    failed: '<red>✗ Failed to change language! Check console for errors.'

banner:
  spigot:
    title: 'MythicRod-Spigot'
    platform: 'Spigot 1.21.4'
    brigadier_style: 'Brigadier-Style ✓'
    version_label: 'v{version}'
  paper:
    title: 'MythicRod-Paper'
    platform: 'Paper 1.21.4'
    brigadier_native: 'Brigadier ✓'
    version_label: 'v{version}'

logging:
  startup_adventure_ready: '[MythicRod-Spigot] Adventure Platform initialized and ready'
  loaded_drops: '[MythicRod-Spigot] Loaded {count} custom drops from configuration'
  startup_success: '[MythicRod-Spigot] All systems initialized successfully in {ms}ms'
  reload_start: '[MythicRod-Spigot] Configuration reload initiated by admin or plugin'
  reload_success: '[MythicRod-Spigot] Configuration and all managers reloaded successfully'
  reload_failed: '[MythicRod-Spigot] Critical error reloading configuration. Check YAML syntax and file permissions.'
  shutdown_success: '[MythicRod-Spigot] Plugin disabled successfully'
  shutdown_error: '[MythicRod-Spigot] Critical error during plugin shutdown. Check for data loss.'
  gui_unknown_menu: '[MythicRod-GUIManager] Unknown menu ID: {menu}. Verify configuration and menu registration.'
  gui_open_error: "[MythicRod-GUIManager] Critical error opening menu '{menu}'. Check stack trace and menu configuration."
  gui_close_warning: '[MythicRod-GUIManager] Non-fatal error closing menu. Player session may be incomplete.'
  gui_click_error: '[MythicRod-GUIManager] Error handling menu interaction. Player action may not have been processed.'
  menu_open_error: '[MythicRod-BaseMenu] Error opening menu for {player}. Menu may not display correctly.'
  mainhub_reload_error: '[MythicRod-MainHubMenu] Critical error during reload from GUI. Configuration may be corrupted. Check file permissions and YAML syntax.'
  config_save_error: '[MythicRod-ConfigMenu] Critical error saving configuration from GUI. Changes may not be persisted. Check file permissions and disk space.'
  lang_invalid_url_format: '[MythicRod-LanguageSwitchMenu] Invalid texture URL format for language head: {url}. Using default skin instead.'
  lang_fetch_failed: '[MythicRod-LanguageSwitchMenu] Failed to fetch language head texture from URL: {url}. Reason: {error}'
  lang_apply_failed: '[MythicRod-LanguageSwitchMenu] Error applying language head texture. Using default skin instead. Check texture URL format.'
  lang_change_failed: '[MythicRod-LanguageSwitchMenu] Critical error changing language. Language may not have been updated. Check configuration files.'

language:
  names:
    en_US: '<white>English'
    en: '<white>English'
    ja_JP: '<white>日本語'
    jp: '<white>日本語'
  current: '<yellow>Currently speaking: <white>{language}'
